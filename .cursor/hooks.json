{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node .cursor/hooks/session-start.mjs",
        "timeout": 15
      }
    ],
    "afterFileEdit": [
      {
        "command": "node .cursor/hooks/after-file-edit.mjs",
        "timeout": 15
      }
    ],
    "afterShellExecution": [
      {
        "command": "node .cursor/hooks/after-shell.mjs",
        "timeout": 15
      }
    ],
    "beforeShellExecution": [
      {
        "command": "node .cursor/hooks/before-shell.mjs",
        "failClosed": true,
        "timeout": 15
      }
    ],
    "stop": [
      {
        "command": "node .cursor/hooks/stop.mjs",
        "loop_limit": 3,
        "timeout": 15
      }
    ]
  }
}
